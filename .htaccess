# .htaccess Security Configuration
# Place this in your root directory

# Protect database configuration file
<Files "db-config.php">
    Order Allow,Deny
    Deny from all
</Files>

# Protect CSRF token generator if accessed directly
<Files "generate-csrf-token.php">
    Order Allow,Deny
    Deny from all
</Files>

# TEMPORARY: real home page, hidden until launch
<Files "index-full.html">
    Order Allow,Deny
    Deny from all
</Files>

# Disallow access to og-image generator
<Files "og-image.html">
    Order Allow,Deny
    Deny from all
</Files>


# Enable PHP error logging (disable display in production)
# php_flag display_errors Off
# php_flag log_errors On
# php_value error_log /path/to/your/error_log

# Prevent directory browsing
Options -Indexes

# Protect against clickjacking
Header always append X-Frame-Options SAMEORIGIN

# XSS Protection
Header set X-XSS-Protection "1; mode=block"

# Prevent MIME type sniffing
Header set X-Content-Type-Options "nosniff"

# Redirect HTTP to HTTPS (also honours X-Forwarded-Proto in case a proxy terminates SSL)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block internal files and folders in case they are copied to the server
RewriteEngine On
RewriteRule ^\.claude(/|$) - [F,L]
RewriteRule \.md$ - [F,L]

# TEMPORARY: LAUNCH-WEEK HOLDING PAGE.
# index.html is the "Launching soon" page (keeps the live <head> so search results are unaffected).
# The real home page is saved as index-full.html and is blocked below.
# These rules serve the holding page (HTTP 200, URLs unchanged) for the other public pages.
# At launch: mv index-full.html index.html, and delete this block and the index-full.html block.
RewriteRule ^(partners|privacy)\.html$ /index.html [L]
RewriteRule ^(join|submit-form)\.php$ /index.html [L]

# Redirect join.html to join.php
RewriteRule ^join\.html$ join.php [L,R=301]

# Old pages were merged into the single-page index (NE keeps the # unescaped)
RewriteRule ^about\.html$ /#about [NE,L,R=301]
RewriteRule ^services\.html$ /#work [NE,L,R=301]
RewriteRule ^why\.html$ /#membership [NE,L,R=301]
