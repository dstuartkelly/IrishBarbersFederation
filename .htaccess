# .htaccess Security Configuration
# Place this in your root directory

# Protect database configuration file
<Files "db-config.php">
    Require all denied
</Files>

# Protect CSRF token generator if accessed directly
<Files "generate-csrf-token.php">
    Require all denied
</Files>

# Disallow access to og-image generator
<Files "og-image.html">
    Require all denied
</Files>


# Enable PHP error logging (disable display in production)
# php_flag display_errors Off
# php_flag log_errors On
# php_value error_log /path/to/your/error_log

# Prevent directory browsing
Options -Indexes

# Protect against clickjacking
Header always append X-Frame-Options SAMEORIGIN

# Prevent MIME type sniffing
Header set X-Content-Type-Options "nosniff"

# Send only the origin to other sites, and switch off browser features the site does not use
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

# Content Security Policy. The pages use no inline scripts or styles; fonts come from Google Fonts.
# If a page ever needs another external source (analytics, maps, embeds), add it here.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

# Redirect HTTP to HTTPS (also honours X-Forwarded-Proto in case a proxy terminates SSL)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block internal files and folders in case they are copied to the server
RewriteEngine On
RewriteRule ^\.claude(/|$) - [F,L]
RewriteRule \.md$ - [F,L]
RewriteRule \.sql$ - [F,L]
RewriteRule ^docker(/|$) - [F,L]
RewriteRule ^(compose\.ya?ml|Dockerfile|\.env.*)$ - [F,L]

# Redirect join.html to join.php
RewriteRule ^join\.html$ /join.php [L,R=301]

# Retired pages were merged into the home page (NE keeps the # unescaped)
RewriteRule ^about\.html$ /#about [NE,L,R=301]
RewriteRule ^services\.html$ /#work [NE,L,R=301]
RewriteRule ^why\.html$ /#membership [NE,L,R=301]
